[Unit]
Description=Suricata Intrusion Detection Service Rules Update
After=network-online.target
Wants=network-online.target
Before=suricata.service suricata-ips.service
# Give up after 10 failed attempts within 10 minutes, the timer tries again later.
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
LimitMEMLOCK=infinity
User=root
Group=root
Type=oneshot
# The network may not be ready right after boot, retry until the rules are downloaded.
Restart=on-failure
RestartSec=30s
ExecStart=/bin/ip vrf exec vrf104009 /usr/bin/suricata-update

[Install]
WantedBy=multi-user.target
